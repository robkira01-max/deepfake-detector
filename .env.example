# ── Base de données ─────────────────────────────────────────────────────────
POSTGRES_USER=deepfake
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=deepfake_db
DATABASE_URL=postgresql://deepfake:changeme_strong_password@postgres:5432/deepfake_db

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis
CELERY_BROKER_URL=redis://:changeme_redis@redis:6379/0
CELERY_RESULT_BACKEND=redis://:changeme_redis@redis:6379/1

# ── MinIO (stockage objets chiffré) ─────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme123_minio
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_CASES=deepfake-cases
MINIO_BUCKET_REPORTS=deepfake-reports
MINIO_USE_SSL=false

# ── Sécurité JWT ─────────────────────────────────────────────────────────────
# Générer avec : openssl genrsa -out private.pem 4096
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── MFA ──────────────────────────────────────────────────────────────────────
MFA_ISSUER=DeepfakeDetector-Canada
MFA_REQUIRED=true

# ── TSA (Time Stamp Authority) — RFC 3161 ────────────────────────────────────
# Dev: FreeTSA.org (gratuit) | Prod: Entrust Canada
TSA_URL=https://freetsa.org/tsr
TSA_CERT_PATH=               # laisser vide pour FreeTSA (auto-téléchargé)

# ── Chemins de données ───────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
QUARANTINE_DIR=/data/quarantine
PROCESSED_DIR=/data/processed

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=DeepfakeDetector
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Limites fichiers ─────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm
ALLOWED_AUDIO_EXTENSIONS=.wav,.mp3,.aac,.flac,.ogg,.m4a

# ── Rétention légale ─────────────────────────────────────────────────────────
RETENTION_YEARS=10
